#!/bin/bash

# -------------------------------
# RENDZZ OFFICIAL - FULL CUSTOM PANEL
# -------------------------------
PTERO_DIR="/var/www/pterodactyl"
WALLPAPER_URL="https://files.catbox.moe/yprqlo.jpg"
LOGO_URL="https://files.catbox.moe/yprqlo.jpg"

echo "🚀 Mulai kostumisasi panel Rendzz Official..."

# -------------------------------
# 1. BACKUP FILE PENTING
# -------------------------------
cp "$PTERO_DIR/resources/views/templates/base/core.blade.php" "$PTERO_DIR/core.bak" 2>/dev/null
cp "$PTERO_DIR/resources/views/templates/base/footer.blade.php" "$PTERO_DIR/footer.bak" 2>/dev/null
cp "$PTERO_DIR/public/logo.png" "$PTERO_DIR/logo.bak" 2>/dev/null
cp "$PTERO_DIR/public/favicon.ico" "$PTERO_DIR/favicon.bak" 2>/dev/null

# -------------------------------
# 2. WALLPAPER (URL BARU)
# -------------------------------
echo "📥 Download wallpaper..."
mkdir -p "$PTERO_DIR/public/rendzz"
curl -L "$WALLPAPER_URL" -o "$PTERO_DIR/public/rendzz/bg.jpg"
chmod 644 "$PTERO_DIR/public/rendzz/bg.jpg"

# -------------------------------
# 3. LOGO & FAVICON (PAKE GAMBAR SAMA)
# -------------------------------
echo "🖼️ Ganti logo & favicon..."
curl -L "$LOGO_URL" -o "$PTERO_DIR/public/logo.png"
curl -L "$LOGO_URL" -o "$PTERO_DIR/public/favicon.ico"
chmod 644 "$PTERO_DIR/public/logo.png" "$PTERO_DIR/public/favicon.ico"

# -------------------------------
# 4. GANTI COPYRIGHT FOOTER
# -------------------------------
echo "©️ Ganti copyright footer..."
sed -i 's/Pterodactyl®/Rendzz Official®/g' "$PTERO_DIR/resources/views/templates/base/footer.blade.php"
sed -i 's/© [0-9]\{4\} - [0-9]\{4\}/© 2025 - 2026/g' "$PTERO_DIR/resources/views/templates/base/footer.blade.php"

# -------------------------------
# 5. INJECT WALLPAPER KE CORE (TANPA GREETING)
# -------------------------------
echo "🎨 Inject wallpaper ke core.blade.php..."
cat > "$PTERO_DIR/resources/views/templates/base/core.blade.php" << 'EOF'
@extends('templates/wrapper', [
    'css' => ['body' => 'bg-neutral-800'],
])

@section('container')
    <div id="modal-portal"></div>
    <div id="app"></div>

    <style>
        /* RENDZZ OFFICIAL BACKGROUND */
        body {
            background: url('/rendzz/bg.jpg') no-repeat center center fixed !important;
            background-size: cover !important;
        }

        /* BIAR KONTEN KEBIACA */
        .content-wrapper, .main-sidebar, .card {
            background-color: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(5px);
        }

        .dark-mode .content-wrapper, 
        .dark-mode .main-sidebar, 
        .dark-mode .card {
            background-color: rgba(31, 41, 55, 0.9) !important;
            backdrop-filter: blur(5px);
        }
    </style>
@endsection
EOF

# -------------------------------
# 6. GANTI TITLE PANEL
# -------------------------------
echo "📝 Ganti title panel..."
sed -i 's/<title>.*<\/title>/<title>Rendzz Official Panel<\/title>/g' "$PTERO_DIR/resources/views/layouts/admin.blade.php" 2>/dev/null
sed -i 's/<title>.*<\/title>/<title>Rendzz Official Panel<\/title>/g' "$PTERO_DIR/resources/views/layouts/auth.blade.php" 2>/dev/null

# -------------------------------
# 7. CLEAR CACHE
# -------------------------------
echo "🧹 Clear cache..."
cd "$PTERO_DIR"
php artisan view:clear
php artisan cache:clear

# -------------------------------
# 8. SELESAI
# -------------------------------
echo ""
echo "✅✅✅  SEMUA BERHASIL!  ✅✅✅"
echo "=================================="
echo "🖼️  Wallpaper : $WALLPAPER_URL"
echo "🖼️  Logo      : $LOGO_URL"
echo "©️  Footer    : Rendzz Official® © 2025 - 2026"
echo "📌 Title     : Rendzz Official Panel"
echo "=================================="
echo "🚀 Refresh browser (CTRL+SHIFT+R) buat liat hasil!"
